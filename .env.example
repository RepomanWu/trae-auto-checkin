# 面板访问密钥（key）：部署后在面板「设置」里也可改
ADMIN_KEY=change-me-please
# 对外端口
PORT=7860
# 时区（影响签到/定时任务的执行时刻）
TZ=Asia/Shanghai

# ---- 国内服务器加速（可选，见 README「国内服务器加速」）----
# 基础镜像换国内镜像源（不加则用 Docker Hub 官方源）
# PYTHON_BASE=docker.m.daocloud.io/library/python:3.11-slim
# 容器内 pip 换国内源（不加则用官方 PyPI）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
